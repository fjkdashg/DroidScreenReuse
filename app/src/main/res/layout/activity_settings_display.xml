<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/back" />

            <Button
                android:id="@+id/saveOnlyButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/save_only" />

            <Button
                android:id="@+id/saveButton"
                style="@style/AccentButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/save" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/time_label" />

            <Switch
                android:id="@+id/time24Switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/time_format_24" />

            <Switch
                android:id="@+id/bootSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/boot_label" />

            <Switch
                android:id="@+id/flipSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/flip_label" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/weather_label" />

            <Switch
                android:id="@+id/autoLocationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/weather_auto_location" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/latEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/weather_lat"
                    android:inputType="numberDecimal|numberSigned"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/lonEdit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/weather_lon"
                    android:inputType="numberDecimal|numberSigned"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
