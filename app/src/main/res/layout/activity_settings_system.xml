<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/backButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/back" />

            <Button
                android:id="@+id/saveOnlyButton"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/save_only" />

            <Button
                android:id="@+id/saveButton"
                style="@style/AccentButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginLeft="8dp"
                android:text="@string/save" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <TextView
                style="@style/SectionTitle"
                android:text="@string/menu_system" />

            <Switch
                android:id="@+id/debugServerSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/debug_server_enable" />

            <TextView
                android:id="@+id/debugServerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFB388FF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.55"
                android:text="@string/debug_server_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout style="@style/Card">

            <Switch
                android:id="@+id/streamServerSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/stream_server_enable" />

            <TextView
                android:id="@+id/streamServerAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFB388FF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.55"
                android:text="@string/stream_server_hint"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
