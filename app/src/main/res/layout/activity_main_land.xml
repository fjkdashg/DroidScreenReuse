<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.droidscreentimer.FlowingBackgroundView
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/infoGroup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/info_bg"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="24dp">

        <!-- 左列（宽 3/4）：上 2/3 时间铺满，下 1/3 日期星期与农历折行 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:orientation="vertical">

            <TextView
                android:id="@+id/timeText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:fontFamily="monospace"
                android:gravity="center"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--:--"
                android:textColor="#FFFFFFFF"
                android:textSize="120sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gregorianText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:text="----年--月--日  星期-"
                    android:textColor="#E6FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/lunarText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="农历--月--"
                    android:textColor="#E6FFFFFF"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 右列（宽 1/4，全高）：温度在上，晴雨图标在下 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="16dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/landscapeTempText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="--°"
                android:textColor="#FFFFFFFF"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/landscapeIconText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="—"
                android:textSize="44sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
